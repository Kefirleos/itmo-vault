@echo off
chcp 65001 > nul
echo ========================================================
echo 🔄 Синхронизация конспектов Obsidian (Git)
echo ========================================================
cd /d "%~dp0\.."

echo 🛡️ Проверка безопасности перед синхронизацией...
python "Скрипты\check_repo_safety.py"
if errorlevel 1 (
    echo.
    echo ❌ ВНИМАНИЕ: Обнаружены потенциально опасные или закрытые файлы!
    echo Синхронизация отменена для защиты от утечки данных.
    echo ========================================================
    pause
    exit /b 1
)

echo.
echo 📥 Получение обновлений (git pull)...
git pull origin main

echo 📝 Добавление изменений...
git add .

set /p msg="Введите описание коммита (или нажмите Enter для авто): "
if "%msg%"=="" set msg=Update notes and study materials: %date% %time%

git commit -m "%msg%"

echo 📤 Отправка в удаленный репозиторий (git push)...
git push origin main

echo ========================================================
echo ✅ Синхронизация успешно завершена!
echo ========================================================
pause